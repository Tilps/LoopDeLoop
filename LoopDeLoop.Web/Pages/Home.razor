                                <label for="debug-note-input">Optional note</label>
                                <span class="debug-note-counter">@Game.DebugNote.Length / @SolveInteractionLog.MaxNoteLength</span>
                            </div>
                            <textarea id="debug-note-input"
                                      class="files-textarea debug-note-textarea"
