        {
            Console.WriteLine($"Error sharing puzzle: {ex.Message}");
        }
    }

    private void ZoomBy(float factor)
    {
        zoomScale = Math.Clamp(zoomScale * factor, MinZoomScale, MaxZoomScale);
        StateHasChanged();
    }

    private void ResetZoom()
    {
        zoomScale = 1.0f;
        panX = 0f;
        panY = 0f;
    }

    [JSInvokable]
    public void OnTwoFingerPanZoom(double svgDx, double svgDy, double scale)
    {
        panX -= (float)svgDx;
        panY -= (float)svgDy;
        if (scale > 0 && Math.Abs(scale - 1.0) > 0.001)
        {
            zoomScale = Math.Clamp(zoomScale * (float)scale, MinZoomScale, MaxZoomScale);
        }
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPan(double svgDx, double svgDy)
    {
        panX -= (float)svgDx;
        panY -= (float)svgDy;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnWheelZoom(double factor)
    {
        zoomScale = Math.Clamp(zoomScale * (float)factor, MinZoomScale, MaxZoomScale);
        StateHasChanged();
    }

    [JSInvokable]
    public void OnWheelUndoRedo(double deltaY)
    {
        if (Game.IsGenerating || Game.CurrentMesh == null || deltaY == 0)
            return;

        if ((wheelDeltaAccumulator > 0 && deltaY < 0) || (wheelDeltaAccumulator < 0 && deltaY > 0))
            wheelDeltaAccumulator = 0;

        wheelDeltaAccumulator += deltaY;

        while (wheelDeltaAccumulator >= WheelUndoRedoStepThreshold)
        {
            wheelDeltaAccumulator -= WheelUndoRedoStepThreshold;
            Game.Undo();
        }

        while (wheelDeltaAccumulator <= -WheelUndoRedoStepThreshold)
        {
            wheelDeltaAccumulator += WheelUndoRedoStepThreshold;
            Game.Redo();
        }
    }

