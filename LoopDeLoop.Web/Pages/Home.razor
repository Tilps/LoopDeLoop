    private const float HeatMapMinThreshold = 0.12f;
    private const int HeatMapBuckets = 16;

    private static readonly string[] HeatColorsLight = BuildHeatColorTable(darkMode: false);
    private static readonly string[] HeatColorsDark = BuildHeatColorTable(darkMode: true);
    private static readonly string[] HeatStrokeWidths = BuildHeatWidthTable();
    private static readonly string[] HeatOpacitiesLight = BuildHeatOpacityTable(darkMode: false);
    private static readonly string[] HeatOpacitiesDark = BuildHeatOpacityTable(darkMode: true);

    private static int GetHeatBucket(float heat)
    {
        float t = Math.Clamp((heat - HeatMapMinThreshold) / (1.0f - HeatMapMinThreshold), 0f, 1f);
        int idx = (int)(t * (HeatMapBuckets - 1) + 0.5f);
        return Math.Clamp(idx, 0, HeatMapBuckets - 1);
    }

    private static string[] BuildHeatColorTable(bool darkMode)
    {
        var table = new string[HeatMapBuckets];
        for (int i = 0; i < HeatMapBuckets; i++)
        {
            float t = (float)i / (HeatMapBuckets - 1);
            int r, g, b;
            if (!darkMode)
            {
                if (t < 0.5f)
                {
                    float u = t * 2f;
                    r = (int)MathF.Round(250 + (249 - 250) * u);
                    g = (int)MathF.Round(204 + (115 - 204) * u);
                    b = (int)MathF.Round(21 + (22 - 21) * u);
                }
                else
                {
                    float u = (t - 0.5f) * 2f;
                    r = (int)MathF.Round(249 + (220 - 249) * u);
                    g = (int)MathF.Round(115 + (38 - 115) * u);
                    b = (int)MathF.Round(22 + (38 - 22) * u);
                }
            }
            else
            {
                if (t < 0.5f)
                {
                    float u = t * 2f;
                    r = (int)MathF.Round(251 + (251 - 251) * u);
                    g = (int)MathF.Round(191 + (146 - 191) * u);
                    b = (int)MathF.Round(36 + (60 - 36) * u);
                }
                else
                {
                    float u = (t - 0.5f) * 2f;
                    r = (int)MathF.Round(251 + (244 - 251) * u);
                    g = (int)MathF.Round(146 + (63 - 146) * u);
                    b = (int)MathF.Round(60 + (94 - 60) * u);
                }
            }
            table[i] = string.Create(CultureInfo.InvariantCulture, $"rgb({r},{g},{b})");
        }
        return table;
    }

    private static string[] BuildHeatWidthTable()
    {
        var table = new string[HeatMapBuckets];
        for (int i = 0; i < HeatMapBuckets; i++)
        {
            float t = (float)i / (HeatMapBuckets - 1);
            float w = 4.5f + t * 5.5f;
            table[i] = w.ToString("0.0", CultureInfo.InvariantCulture);
        }
        return table;
    }

    private static string[] BuildHeatOpacityTable(bool darkMode)
    {
        var table = new string[HeatMapBuckets];
        float minOp = darkMode ? 0.28f : 0.26f;
        float span = darkMode ? 0.60f : 0.56f;
        for (int i = 0; i < HeatMapBuckets; i++)
        {
            float t = (float)i / (HeatMapBuckets - 1);
            float op = minOp + t * span;
            table[i] = op.ToString("0.00", CultureInfo.InvariantCulture);
        }
        return table;
    }

