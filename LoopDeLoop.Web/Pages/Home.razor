@page "/"
@using System.Globalization
@using System.Text
@using System.Text.Json
@using LoopDeLoop.Web.Services
@inject GameService Game
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Loop-de-loop - Slitherlink Puzzle Game</PageTitle>

<div class="game-container">
    @if (hasPwaUpdate)
    {
        <div class="update-banner" role="status" aria-live="polite">
            <span>✨ A new version is available!</span>
            <button class="btn" @onclick="ReloadFromServer">Update Now</button>
            <button class="btn" style="background:transparent;color:#ffffff;" aria-label="Dismiss update banner" @onclick="() => hasPwaUpdate = false">✕</button>
        </div>
    }

    <!-- Header / Controls -->
    <header class="game-header">
        <!-- Persistent Action Bar: Undo, Redo, Fix, Unfix, Revert, Timer, Menu Toggle -->
        <div class="action-bar">
            <div class="action-buttons-group">
                <button class="btn btn-secondary action-btn undo-btn" @onclick="Game.Undo" disabled="@(!Game.CanUndo || Game.IsGenerating || Game.IsBusy)" title="Undo (Ctrl+Z)" aria-label="Undo">
                    <span class="btn-icon" aria-hidden="true">↶</span><span class="btn-text">Undo</span>
                </button>
                <button class="btn btn-secondary action-btn redo-btn" @onclick="Game.Redo" disabled="@(!Game.CanRedo || Game.IsGenerating || Game.IsBusy)" title="Redo (Ctrl+Y)" aria-label="Redo">
                    <span class="btn-icon" aria-hidden="true">↷</span><span class="btn-text">Redo</span>
                </button>
                <button class="btn btn-secondary action-btn" @onclick="Game.Fix" disabled="@(Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy)" title="Save Checkpoint (Ctrl+F)">
                    Fix
                </button>
                <button class="btn btn-secondary action-btn" @onclick="Game.Unfix" disabled="@(Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy)" title="Clear Checkpoint (Ctrl+U)">
                    Unfix
                </button>
                <button class="btn btn-secondary action-btn" @onclick="Game.RevertToFix" disabled="@(Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy)" title="Revert to Checkpoint (Ctrl+R)">
                    Revert
                </button>
            </div>

            <div class="action-meta-group">
                <GameTimer />

                <!-- Desktop Utilities (Share, Files/Print, Theme, Settings, Help, Reload) -->
                <div class="desktop-utility-group">
                    <button class="btn btn-secondary" @onclick="SharePuzzle" disabled="@(Game.CurrentMesh == null || Game.IsGenerating)" title="Copy shareable link to this puzzle">
                        🔗 Share
                    </button>
                    <button class="btn btn-secondary" @onclick="OpenFilesModal" disabled="@(Game.IsGenerating || Game.IsBusy)" title="Import, Export (.loop / .txt / .loopy) &amp; Print">
                        📁 Files
                    </button>
                    <button class="btn btn-secondary" @onclick="ToggleTheme" title="Toggle Dark/Light Mode" aria-label="@(isDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")">
                        @(isDarkMode ? "☀️" : "🌙")
                    </button>
                    <button class="btn btn-secondary" @onclick="OpenSettings" title="Preferences &amp; Solver Settings">
                        🎛️ Settings
                    </button>
                    <button class="btn btn-secondary" @onclick="() => showHelpModal = true" title="Instructions &amp; Rules">
                        Help
                    </button>
                    <button class="btn btn-secondary" @onclick="ReloadFromServer" title="Reload newest version from server" aria-label="Reload newest version from server">
                        🔄
                    </button>
                </div>

                <!-- Mobile Menu / Options Toggle -->
                <button class="btn btn-secondary menu-toggle-btn @(isMenuOpen ? "active" : "")"
                        @onclick="() => isMenuOpen = !isMenuOpen"
                        title="Puzzle Options &amp; Setup"
                        aria-label="@(isMenuOpen ? "Close puzzle options" : "Open puzzle options")"
                        aria-expanded="@isMenuOpen">
                    @(isMenuOpen ? "✕" : "⚙️")
                </button>
            </div>
        </div>

        <!-- Collapsible Options Panel (Hidden on mobile by default, expanded via ⚙️; Always visible on desktop) -->
        <div class="header-collapsible @(isMenuOpen ? "open" : "")">
            <div class="brand">
                <h1 class="brand-title">Loop-de-loop</h1>
                <button class="mobile-close-btn" @onclick="() => isMenuOpen = false" title="Close Options" aria-label="Close Options">✕</button>
            </div>

            <div class="controls-group">
                <div class="control-item">
                    <label for="grid-type-select">Grid:</label>
                    <select id="grid-type-select" class="select-input" value="@selectedType" @onchange="OnTypeChanged" disabled="@Game.IsGenerating">
                        @foreach (var opt in GridTypeOptions)
                        {
                            <option value="@opt.Type.ToString()">@opt.Label</option>
                        }
                    </select>
                </div>

                <div class="control-item">
                    <label for="grid-size-input">Size:</label>
                    <input id="grid-size-input" type="text" class="text-input" @bind="Game.SizeText" placeholder="10x10" disabled="@Game.IsGenerating" />
                </div>

                <div class="control-item">
                    <label for="grid-difficulty-select">Difficulty:</label>
                    <select id="grid-difficulty-select" class="select-input" @bind="Game.Difficulty" disabled="@Game.IsGenerating">
                        <option value="0">Trivial</option>
                        <option value="1">Easy</option>
                        <option value="2">Easyish</option>
                        <option value="3">Moderate</option>
                        <option value="4">Maybe Harder</option>
                        <option value="5">Unlimited</option>
                    </select>
                </div>

                <button class="btn btn-primary" @onclick="OnNewPuzzleClicked" disabled="@(Game.IsGenerating || Game.IsBusy)">
                    @if (Game.IsGenerating)
                    {
                        <span>Generating...</span>
                    }
                    else
                    {
                        <span>New Puzzle</span>
                    }
                </button>
                <button class="btn btn-secondary" @onclick="PromptResetPuzzle" disabled="@(Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy)" title="Clear all moves and restart timer">
                    Reset
                </button>
            </div>

            <div class="controls-group">
                <button class="btn btn-secondary" @onclick="RequestHintAsync" disabled="@(Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy || Game.IsSolved)" title="Highlight next logical deduction (Ctrl+H)">
                    💡 Hint
                </button>
                <button class="btn btn-secondary" @onclick="RequestDoHintAsync" disabled="@(Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy || Game.IsSolved)" title="Apply next logical deduction (Ctrl+Shift+H)">
                    ⚡ Do Hint
                </button>
                <button class="btn @(Game.ShowHintHeatMap ? "btn-heatmap-active" : "btn-secondary")"
                        @onclick="ToggleHintHeatMapAsync"
                        disabled="@(Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy || Game.IsSolved)"
                        aria-pressed="@Game.ShowHintHeatMap"
                        title="Highlight the most promising areas to examine next">
                    🔥 Heat Map
                </button>
                <button class="btn btn-danger-outline" @onclick="PromptSolve" disabled="@(Game.CurrentMesh == null || Game.IsGenerating || Game.IsBusy || Game.IsSolved)" title="Give up and reveal solution">
                    🏳️ Solve
                </button>
            </div>

            <div class="controls-group">
                <label class="checkbox-label" title="Disallow moves that cause obvious rule violations (exceeding clue counts or vertex degree > 2)">
                    <input type="checkbox" @bind="Game.DisallowFalseMove" @bind:after="OnSettingsChangedAsync" />
                    <span>Restrict invalid</span>
                </label>
                <label class="checkbox-label" title="Enable cell coloring for inside/outside marking (when off, clicking inside routes to nearest edge)">
                    <input type="checkbox" @bind="Game.ShowCellColors" @bind:after="OnSettingsChangedAsync" />
                    <span>Cell shading</span>
                </label>
            </div>

            <!-- Mobile Utility Group (Shown inside collapsible menu on mobile) -->
            <div class="mobile-utility-group">
                <button class="btn btn-secondary" @onclick="SharePuzzle" disabled="@(Game.CurrentMesh == null || Game.IsGenerating)" title="Copy shareable link to this puzzle">
                    🔗 Share
                </button>
                <button class="btn btn-secondary" @onclick="OpenFilesModal" disabled="@(Game.IsGenerating)" title="Import, Export &amp; Print">
                    📁 Files / Print
                </button>
                <button class="btn btn-secondary" @onclick="ToggleTheme" title="Toggle Dark/Light Mode">
                    @(isDarkMode ? "☀️ Light" : "🌙 Dark")
                </button>
                <button class="btn btn-secondary" @onclick="OpenSettings" title="Preferences &amp; Solver Settings">
                    🎛️ Settings
                </button>
                <button class="btn btn-secondary" @onclick="() => showHelpModal = true" title="Instructions &amp; Rules">
                    Help
                </button>
                <button class="btn btn-secondary" @onclick="ReloadFromServer" title="Reload newest version from server">
                    🔄 Reload
                </button>
            </div>
        </div>
    </header>

    <!-- Main Game Board -->
    <main class="board-container">
        @if (Game.IsGenerating)
        {
            int pct = Game.TotalCells > 0 ? (int)Math.Clamp((double)Game.PrunedProgress / Game.TotalCells * 100.0, 0, 100) : 0;
            <div class="overlay-spinner" role="status" aria-live="polite">
                <div class="spinner"></div>
                <div class="spinner-content">
                    <div class="spinner-text">
                        @if (Game.PrunedProgress > 0 && Game.TotalCells > 0)
                        {
                            <span>Pruning clues... (@Game.PrunedProgress / @Game.TotalCells checked)</span>
                        }
                        else
                        {
                            <span>Generating initial loop...</span>
                        }
                    </div>
                    @if (Game.PrunedProgress > 0 && Game.TotalCells > 0)
                    {
                        <div class="progress-bar-container" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar-fill" style="width: @(pct.ToString(CultureInfo.InvariantCulture))%"></div>
                        </div>
                    }

                    @if (Game.GenerationElapsedSeconds >= 10)
                    {
                        <div class="generation-timeout-hint">
                            Generation is taking longer than usual (@($"{(int)Game.GenerationElapsedSeconds}s"))...
                        </div>
                        <button class="cancel-gen-btn" @onclick="Game.CancelGeneration" title="Cancel generation and keep existing board">
                            ✕ Cancel Generation
                        </button>
                    }
                </div>
            </div>
        }
        else if (Game.IsBusy)
        {
            <div class="overlay-spinner" role="status" aria-live="polite">
                <div class="spinner"></div>
                <div class="spinner-content">
                    <div class="spinner-text">@(Game.BusyMessage ?? "Working...")</div>
                </div>
            </div>
        }

        @if (Game.CurrentMesh != null)
        {
            var mesh = Game.CurrentMesh;
            var geom = GetOrBuildGeometry(mesh);

            float curW = geom.BaseW / zoomScale;
            float curH = geom.BaseH / zoomScale;
            float effX = geom.CenterX - (curW / 2.0f) + panX;
            float effY = geom.CenterY - (curH / 2.0f) + panY;
            string viewBoxStr = string.Create(CultureInfo.InvariantCulture, $"{effX:F1} {effY:F1} {curW:F1} {curH:F1}");

            <svg id="game-board-svg" class="svg-board" viewBox="@viewBoxStr" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Loop-de-loop puzzle board">
                <!-- Layer 1: Cell backgrounds (for interior/exterior shading) -->
                <g class="cells-layer" style="pointer-events: none;">
                    @for (int c = 0; c < mesh.Cells.Count; c++)
                    {
                        var cell = mesh.Cells[c];
                        string cellFill = "transparent";
                        if (!Game.IsVisualSolving)
                        {
                            if (cell.Color == 1) cellFill = "var(--cell-yellow)";
                            else if (cell.Color == -1) cellFill = "var(--cell-gray)";
                        }

                        <polygon @key="c"
                                 points="@geom.CellPolygonPoints[c]"
                                 fill="@cellFill"
                                 class="cell-poly"
                                 style="pointer-events: none;" />
                    }
                </g>

                <!-- Layer 2: Empty Grid Edges (faint background guidelines or loop grouping colors) -->
                <g class="empty-edges-layer" style="pointer-events: none;">
                    @for (int e = 0; e < mesh.Edges.Count; e++)
                    {
                        var edge = mesh.Edges[e];
                        if (GetDisplayEdgeState(mesh, e) == EdgeState.Empty)
                        {
                            if (Game.ShowEdgeColors && !Game.IsVisualSolving && edge.Color != 0)
                            {
                                string groupStroke = GetEdgeGroupColor(edge.Color);
                                string? dashArray = edge.Color < 0 ? "5 4" : null;
                                <line @key="e"
                                      x1="@geom.EdgeX1Str[e]" y1="@geom.EdgeY1Str[e]" x2="@geom.EdgeX2Str[e]" y2="@geom.EdgeY2Str[e]"
                                      stroke="@groupStroke"
                                      stroke-dasharray="@dashArray"
                                      class="edge-grouped"
                                      style="pointer-events: none;" />
                            }
                            else
                            {
                                <line @key="e"
                                      x1="@geom.EdgeX1Str[e]" y1="@geom.EdgeY1Str[e]" x2="@geom.EdgeX2Str[e]" y2="@geom.EdgeY2Str[e]"
                                      class="edge-empty"
                                      style="pointer-events: none;" />
                            }
                        }
                    }
                </g>

                <!-- Layer 2b: Hint Heat Map (warm glow on high-priority empty edges) -->
                @if (Game.ShowHintHeatMap && !Game.IsVisualSolving && !Game.IsSolved && Game.EdgeHeatScores is { } heatScores && heatScores.Length == mesh.Edges.Count)
                {
                    <g class="heatmap-layer" style="pointer-events: none;">
                        @for (int e = 0; e < mesh.Edges.Count; e++)
                        {
                            float heat = heatScores[e];
                            if (heat >= HeatMapMinThreshold && mesh.Edges[e].State == EdgeState.Empty)
                            {
                                int bucket = GetHeatBucket(heat);
                                <line @key="e"
                                      x1="@geom.EdgeX1Str[e]" y1="@geom.EdgeY1Str[e]" x2="@geom.EdgeX2Str[e]" y2="@geom.EdgeY2Str[e]"
                                      stroke="@(isDarkMode ? HeatColorsDark[bucket] : HeatColorsLight[bucket])"
                                      stroke-width="@HeatStrokeWidths[bucket]"
                                      stroke-opacity="@(isDarkMode ? HeatOpacitiesDark[bucket] : HeatOpacitiesLight[bucket])"
                                      class="edge-heatmap"
                                      style="pointer-events: none;" />
                            }
                        }
                    </g>
                }

                <!-- Layer 3: Cell Clue Numbers (rendered as pure SVG text, always on top of background lines) -->
                <g class="cell-clues-layer" style="pointer-events: none;">
                    @for (int c = 0; c < mesh.Cells.Count; c++)
                    {
                        var cell = mesh.Cells[c];
                        if (cell.TargetCount >= 0)
                        {
                            int filledCount = Game.IsVisualSolving ? 0 : cell.FilledCount;
                            if (Game.IsVisualSolving)
                            {
                                foreach (var edgeIdx in cell.Edges)
                                {
                                    if (GetDisplayEdgeState(mesh, edgeIdx) == EdgeState.Filled)
                                        filledCount++;
                                }
                            }

                            string numColor = "var(--clue-default)";
                            if (filledCount == cell.TargetCount) numColor = "var(--clue-satisfied)";
                            else if (filledCount > cell.TargetCount) numColor = "var(--danger)";

                            <SvgClueText @key="c"
                                         X="@geom.CellMidXStr[c]"
                                         Y="@geom.CellMidYStr[c]"
                                         FontSize="@geom.CellFontSizeStr[c]"
                                         Color="@numColor"
                                         Clue="@cell.TargetCount" />
                        }
                    }
                </g>

                <!-- Layer 4: Active Edges (Filled loops & Excluded cross marks) -->
                <g class="active-edges-layer" style="pointer-events: none;">
                    @for (int e = 0; e < mesh.Edges.Count; e++)
                    {
                        EdgeState edgeState = GetDisplayEdgeState(mesh, e);
                        if (edgeState != EdgeState.Empty)
                        {
                            bool isMarked = !Game.IsVisualSolving && Game.MarkedEdges.Contains(e);

                            if (edgeState == EdgeState.Filled)
                            {
                                <line @key="e"
                                      x1="@geom.EdgeX1Str[e]" y1="@geom.EdgeY1Str[e]" x2="@geom.EdgeX2Str[e]" y2="@geom.EdgeY2Str[e]"
                                      class="@(isMarked ? "edge-filled-marked" : "edge-filled")"
                                      style="pointer-events: none;" />
                            }
                            else if (edgeState == EdgeState.Excluded)
                            {
                                string crossClass = isMarked ? "edge-cross-marked" : "edge-cross";
                                <g @key="e" style="pointer-events: none;">
                                    <line x1="@geom.Cross1X1Str[e]" y1="@geom.Cross1Y1Str[e]" x2="@geom.Cross1X2Str[e]" y2="@geom.Cross1Y2Str[e]"
                                          class="@crossClass"
                                          style="pointer-events: none;" />
                                    <line x1="@geom.Cross2X1Str[e]" y1="@geom.Cross2Y1Str[e]" x2="@geom.Cross2X2Str[e]" y2="@geom.Cross2Y2Str[e]"
                                          class="@crossClass"
                                          style="pointer-events: none;" />
                                </g>
                            }
                        }
                    }
                </g>

                <!-- Layer 5: Intersection Vertices (clean corner dots) -->
                <g class="vertices-layer" style="pointer-events: none;">
                    @for (int v = 0; v < geom.VertexXStr.Length; v++)
                    {
                        <circle @key="v" cx="@geom.VertexXStr[v]" cy="@geom.VertexYStr[v]" r="3.5" class="vertex-dot" style="pointer-events: none;" />
                    }
                </g>

                <!-- Layer 6: Dynamic Edge Highlights (Invalid move red flash, grouping anchor, & Hint glow) -->
                <g class="highlights-layer" style="pointer-events: none;">
                    @if (Game.PendingGroupEdgeIndex is int grpIdx && grpIdx >= 0 && grpIdx < mesh.Edges.Count)
                    {
                        <line x1="@geom.EdgeX1Str[grpIdx]" y1="@geom.EdgeY1Str[grpIdx]" x2="@geom.EdgeX2Str[grpIdx]" y2="@geom.EdgeY2Str[grpIdx]"
                              class="edge-group-pending"
                              style="pointer-events: none;" />
                    }
                    @if (Game.InvalidEdgeIndex is int invIdx && invIdx >= 0 && invIdx < mesh.Edges.Count)
                    {
                        <line x1="@geom.EdgeX1Str[invIdx]" y1="@geom.EdgeY1Str[invIdx]" x2="@geom.EdgeX2Str[invIdx]" y2="@geom.EdgeY2Str[invIdx]"
                              class="edge-invalid-highlight"
                              style="pointer-events: none;" />
                    }
                    @if (Game.HintEdgeIndex is int hintIdx && hintIdx >= 0 && hintIdx < mesh.Edges.Count)
                    {
                        if (!Game.HintIsApplied)
                        {
                            <line x1="@geom.EdgeX1Str[hintIdx]" y1="@geom.EdgeY1Str[hintIdx]" x2="@geom.EdgeX2Str[hintIdx]" y2="@geom.EdgeY2Str[hintIdx]"
                                  class="edge-hint-neutral"
                                  style="pointer-events: none;" />
                        }
                        else if (Game.HintTargetState == EdgeState.Excluded)
                        {
                            <line x1="@geom.HintCross1X1Str[hintIdx]" y1="@geom.HintCross1Y1Str[hintIdx]" x2="@geom.HintCross1X2Str[hintIdx]" y2="@geom.HintCross1Y2Str[hintIdx]"
                                  class="edge-hint-cross" style="pointer-events: none;" />
                            <line x1="@geom.HintCross2X1Str[hintIdx]" y1="@geom.HintCross2Y1Str[hintIdx]" x2="@geom.HintCross2X2Str[hintIdx]" y2="@geom.HintCross2Y2Str[hintIdx]"
                                  class="edge-hint-cross" style="pointer-events: none;" />
                        }
                        else
                        {
                            <line x1="@geom.EdgeX1Str[hintIdx]" y1="@geom.EdgeY1Str[hintIdx]" x2="@geom.EdgeX2Str[hintIdx]" y2="@geom.EdgeY2Str[hintIdx]"
                                  class="edge-hint-highlight"
                                  style="pointer-events: none;" />
                        }
                    }
                </g>
            </svg>

            <!-- Conditional Visual Step-by-Step Solver Playback Bar -->
            @if (Game.IsVisualSolving && Game.CurrentVisualSolveStep is { } vsStep)
            {
                string badgeClass = vsStep.IsBacktrack ? "visual-solver-status backtrack" : (vsStep.IsBranching ? "visual-solver-status branch" : "visual-solver-status");
                <div class="visual-solver-bar" role="region" aria-label="Visual Solver Playback">
                    <div class="visual-solver-header">
                        <span class="visual-solver-step">Step @(Game.VisualSolveStepIndex + 1) / @Game.VisualSolveTotalSteps</span>
                        <span class="@badgeClass">@vsStep.Status</span>
                    </div>
                    <div class="visual-solver-controls">
                        <button class="btn btn-secondary visual-solver-btn" @onclick="VisualSolveStart" disabled="@(Game.VisualSolveStepIndex <= 0)" title="Jump to start" aria-label="Jump to start">⏮</button>
                        <button class="btn btn-secondary visual-solver-btn" @onclick="VisualSolvePrev" disabled="@(Game.VisualSolveStepIndex <= 0)" title="Previous step" aria-label="Previous step">◀</button>
                        <button class="btn btn-primary visual-solver-btn" @onclick="ToggleVisualSolvePlay" title="@(isVisualSolvePlaying ? "Pause" : "Play")">
                            @(isVisualSolvePlaying ? "⏸ Pause" : "▶ Play")
                        </button>
                        <button class="btn btn-secondary visual-solver-btn" @onclick="VisualSolveNext" disabled="@(Game.VisualSolveStepIndex >= Game.VisualSolveTotalSteps - 1)" title="Next step" aria-label="Next step">▶</button>

                        <input type="range"
                               class="visual-solver-slider"
                               min="0"
                               max="@(Math.Max(0, Game.VisualSolveTotalSteps - 1))"
                               value="@Game.VisualSolveStepIndex"
                               @oninput="OnVisualSolveStepInput"
                               aria-label="Solver playback step" />

                        <select class="select-input visual-solver-speed" @bind="visualSolveSpeedMs" aria-label="Playback speed" title="Playback Speed">
                            <option value="450">0.5x</option>
                            <option value="220">1x</option>
                            <option value="110">2x</option>
                            <option value="45">5x</option>
                            <option value="15">Max</option>
                        </select>

                        <button class="btn btn-success visual-solver-btn" @onclick="ApplyVisualSolve" title="Apply complete solution to the board">✓ Apply</button>
                        <button class="btn btn-secondary visual-solver-btn" @onclick="DismissVisualSolve" title="Exit visual solver and return to your board" aria-label="Close visual solver">✕</button>
                    </div>
                </div>
            }

            @if ((Game.ShowHintHeatMap && !Game.IsVisualSolving && !Game.IsSolved && Game.EdgeHeatScores != null) || Game.DebugRecordingEnabled)
            {
                <div class="board-left-hud">
                    @if (Game.DebugRecordingEnabled)
                    {
                        <button class="debug-pill" @onclick="OpenDebugModalAsync" title="Inspect, copy, submit, or paste recorded solve interaction log">
                            🐞 Debug (@Game.DebugEventCount)
                        </button>
                    }
                    @if (Game.ShowHintHeatMap && !Game.IsVisualSolving && !Game.IsSolved && Game.EdgeHeatScores != null)
                    {
                        <div class="heatmap-legend" role="status" aria-label="Hint heat map active">
                            <span class="heatmap-legend-label">🔥 Focus</span>
                            <span class="heatmap-legend-bar" aria-hidden="true"></span>
                            <span class="heatmap-legend-scale">Hot</span>
                            <button class="heatmap-legend-close" @onclick="ToggleHintHeatMapAsync" title="Turn off Heat Map" aria-label="Turn off Heat Map">✕</button>
                        </div>
                    }
                </div>
            }

            <!-- Floating Pan & Zoom Controls -->
            <div class="zoom-hud" role="group" aria-label="Zoom and pan controls">
                <button class="zoom-btn" @onclick="() => ZoomBy(1.25f)" title="Zoom In (+)" aria-label="Zoom in">+</button>
                <button class="zoom-btn" @onclick="() => ZoomBy(0.8f)" title="Zoom Out (−)" aria-label="Zoom out">−</button>
                <button class="zoom-btn" @onclick="ResetZoom" title="Reset Pan &amp; Zoom" aria-label="Reset pan and zoom">⟲</button>
            </div>
        }
    </main>

    <!-- Footer Shortcuts Info -->
    <footer class="game-footer">
        <div>
            Shortcuts:
            <span class="shortcut-badge">Ctrl+Z</span> Undo &bull;
            <span class="shortcut-badge">Ctrl+Y</span> Redo &bull;
            <span class="shortcut-badge">Ctrl+F</span> Fix &bull;
            <span class="shortcut-badge">Ctrl+U</span> Unfix &bull;
            <span class="shortcut-badge">Ctrl+R</span> Revert &bull;
            <span class="shortcut-badge">Ctrl+H</span> Hint &bull;
            <span class="shortcut-badge">Ctrl+Shift+H</span> Do Hint
        </div>
        <div>
            Left-Click / Drag: Draw line &bull; Right-Click / Drag: Mark X &bull; Shift: Reverse cycle &bull; Fixed edges locked &bull; Two fingers / Wheel: Pan & Zoom
        </div>
    </footer>
</div>

@if (showShareToast)
{
    <div class="toast-notification" role="status" aria-live="polite">
        @shareToastMessage
    </div>
}

@if (!string.IsNullOrEmpty(Game.HintMessage))
{
    <div class="hint-toast-notification" role="status" aria-live="polite">
        <div class="hint-toast-content">
            <span class="hint-toast-icon" aria-hidden="true">💡</span>
