    private void ToggleVisualSolvePlay()
    {
        if (!Game.IsVisualSolving) return;
        if (isVisualSolvePlaying)
        {
            StopVisualSolvePlayback();
        }
        else
        {
            if (Game.VisualSolveStepIndex >= Game.VisualSolveTotalSteps - 1)
                Game.SetVisualSolveStep(0);
            StartVisualSolvePlayback();
        }
    }

    private void StartVisualSolvePlayback()
    {
        StopVisualSolvePlayback();
        if (!Game.IsVisualSolving) return;

        isVisualSolvePlaying = true;
        visualSolvePlayCts = new CancellationTokenSource();
        _ = RunVisualSolvePlaybackAsync(visualSolvePlayCts.Token);
    }

    private void StopVisualSolvePlayback()
    {
        isVisualSolvePlaying = false;
        var prev = visualSolvePlayCts;
        visualSolvePlayCts = null;
        if (prev != null)
        {
            prev.Cancel();
            prev.Dispose();
        }
    }

    private async Task RunVisualSolvePlaybackAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested && isVisualSolvePlaying && Game.IsVisualSolving)
            {
                await Task.Delay(Math.Clamp(visualSolveSpeedMs, 15, 1000), token);
                if (token.IsCancellationRequested || !Game.IsVisualSolving) break;

                bool advanced = Game.StepVisualSolveForward();
                if (!advanced)
                {
                    StopVisualSolvePlayback();
                    await InvokeAsync(StateHasChanged);
                    break;
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void VisualSolveStart()
    {
        StopVisualSolvePlayback();
        Game.SetVisualSolveStep(0);
    }

    private void VisualSolvePrev()
    {
        StopVisualSolvePlayback();
        Game.StepVisualSolveBackward();
