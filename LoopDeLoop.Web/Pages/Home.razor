    private async Task SubmitDebugLogAsync()
    {
        if (isSubmittingDebugLog || !Game.DebugRecordingEnabled)
            return;

        isSubmittingDebugLog = true;
        debugSubmitMessage = null;
        debugSubmitIsError = false;
        try
        {
            await EnsureDebugInstallIdAsync();
            await SyncDebugClientInfoAsync();
            string json = Game.ExportDebugLogJson();
            if (string.IsNullOrEmpty(json))
            {
                debugSubmitMessage = "No interaction log recorded yet.";
                debugSubmitIsError = true;
                debugStatusMessage = debugSubmitMessage;
                debugStatusIsError = true;
                return;
            }

            debugLogText = json;
            string resultJson = await JS.InvokeAsync<string>("loopHelpers.submitDebugLogJson", json);
            var res = JsonSerializer.Deserialize(resultJson, LoopJsonContext.Default.DebugSubmitResult);
            if (res is { Ok: true })
            {
                debugSubmitted = true;
                string idSuffix = !string.IsNullOrEmpty(res.Id) ? $" ({res.Id})" : string.Empty;
                debugSubmitMessage = $"Uploaded{idSuffix}!";
                debugSubmitIsError = false;
                debugStatusMessage = debugSubmitMessage;
                debugStatusIsError = false;
            }
            else
            {
                debugSubmitMessage = res?.Message ?? "Upload failed.";
                debugSubmitIsError = true;
                debugStatusMessage = debugSubmitMessage;
                debugStatusIsError = true;
            }
        }
        catch (Exception ex) when (ex is JSException or JsonException)
        {
            debugSubmitMessage = "Could not upload debug log.";
            debugSubmitIsError = true;
            debugStatusMessage = debugSubmitMessage;
            debugStatusIsError = true;
        }
        finally
        {
            isSubmittingDebugLog = false;
        }
    }

