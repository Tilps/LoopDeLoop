    private static string Fmt(float v) => v.ToString("0.#", CultureInfo.InvariantCulture);

    private CachedMeshGeometry GetOrBuildGeometry(Mesh mesh)
    {
        if (ReferenceEquals(cachedGeometryMesh, mesh) && cachedGeometry != null)
            return cachedGeometry;

        int vCount = mesh.Intersections.Count;
        int eCount = mesh.Edges.Count;
        int cCount = mesh.Cells.Count;

        var geom = new CachedMeshGeometry
        {
            CellPolygonPoints = new string[cCount],
            CellMidX = new float[cCount],
            CellMidY = new float[cCount],
            CellMidXStr = new string[cCount],
            CellMidYStr = new string[cCount],
            CellFontSizeStr = new string[cCount],
            EdgeX1 = new float[eCount],
            EdgeY1 = new float[eCount],
            EdgeX2 = new float[eCount],
            EdgeY2 = new float[eCount],
            EdgeX1Str = new string[eCount],
            EdgeY1Str = new string[eCount],
            EdgeX2Str = new string[eCount],
            EdgeY2Str = new string[eCount],
            Cross1X1Str = new string[eCount],
            Cross1Y1Str = new string[eCount],
            Cross1X2Str = new string[eCount],
            Cross1Y2Str = new string[eCount],
            Cross2X1Str = new string[eCount],
            Cross2Y1Str = new string[eCount],
            Cross2X2Str = new string[eCount],
            Cross2Y2Str = new string[eCount],
            HintCross1X1Str = new string[eCount],
            HintCross1Y1Str = new string[eCount],
            HintCross1X2Str = new string[eCount],
            HintCross1Y2Str = new string[eCount],
            HintCross2X1Str = new string[eCount],
            HintCross2Y1Str = new string[eCount],
            HintCross2X2Str = new string[eCount],
            HintCross2Y2Str = new string[eCount],
            VertexXStr = new string[vCount],
            VertexYStr = new string[vCount]
        };

        float minX = float.MaxValue, minY = float.MaxValue, maxX = float.MinValue, maxY = float.MinValue;
        for (int v = 0; v < vCount; v++)
        {
            float x = mesh.Intersections[v].X * S;
            float y = mesh.Intersections[v].Y * S;
            if (x < minX) minX = x;
            if (y < minY) minY = y;
            if (x > maxX) maxX = x;
            if (y > maxY) maxY = y;
            geom.VertexXStr[v] = Fmt(x);
            geom.VertexYStr[v] = Fmt(y);
        }

        if (vCount == 0)
        {
            minX = minY = 0;
            maxX = maxY = 100;
        }

        const float pad = 30.0f;
        geom.BaseW = Math.Max(100.0f, (maxX - minX) + pad * 2);
        geom.BaseH = Math.Max(100.0f, (maxY - minY) + pad * 2);
        geom.CenterX = (minX + maxX) / 2.0f;
        geom.CenterY = (minY + maxY) / 2.0f;

        for (int e = 0; e < eCount; e++)
        {
            mesh.GetEdgeExtent(mesh.Edges[e], out float rawX1, out float rawY1, out float rawX2, out float rawY2);
            float x1 = rawX1 * S, y1 = rawY1 * S, x2 = rawX2 * S, y2 = rawY2 * S;
            geom.EdgeX1[e] = x1;
            geom.EdgeY1[e] = y1;
            geom.EdgeX2[e] = x2;
            geom.EdgeY2[e] = y2;
            geom.EdgeX1Str[e] = Fmt(x1);
            geom.EdgeY1Str[e] = Fmt(y1);
            geom.EdgeX2Str[e] = Fmt(x2);
            geom.EdgeY2Str[e] = Fmt(y2);

            float mx = (x1 + x2) / 2.0f;
            float my = (y1 + y2) / 2.0f;
            float edx = x2 - x1;
            float edy = y2 - y1;
            float elen = MathF.Sqrt(edx * edx + edy * edy);
            if (elen < 1e-4f) elen = 1.0f;
            float ux = edx / elen;
            float uy = edy / elen;
            float vx = -uy;
            float vy = ux;

            const float r = 3.6f;
            float o1x = r * (ux + vx), o1y = r * (uy + vy);
            float o2x = r * (ux - vx), o2y = r * (uy - vy);
            geom.Cross1X1Str[e] = Fmt(mx - o1x);
            geom.Cross1Y1Str[e] = Fmt(my - o1y);
            geom.Cross1X2Str[e] = Fmt(mx + o1x);
            geom.Cross1Y2Str[e] = Fmt(my + o1y);
            geom.Cross2X1Str[e] = Fmt(mx - o2x);
            geom.Cross2Y1Str[e] = Fmt(my - o2y);
            geom.Cross2X2Str[e] = Fmt(mx + o2x);
            geom.Cross2Y2Str[e] = Fmt(my + o2y);

            const float hr = 6.0f;
            float ho1x = hr * (ux + vx), ho1y = hr * (uy + vy);
            float ho2x = hr * (ux - vx), ho2y = hr * (uy - vy);
            geom.HintCross1X1Str[e] = Fmt(mx - ho1x);
            geom.HintCross1Y1Str[e] = Fmt(my - ho1y);
            geom.HintCross1X2Str[e] = Fmt(mx + ho1x);
            geom.HintCross1Y2Str[e] = Fmt(my + ho1y);
            geom.HintCross2X1Str[e] = Fmt(mx - ho2x);
            geom.HintCross2Y1Str[e] = Fmt(my - ho2y);
            geom.HintCross2X2Str[e] = Fmt(mx + ho2x);
            geom.HintCross2Y2Str[e] = Fmt(my + ho2y);
        }

        var sb = new StringBuilder();
        for (int c = 0; c < cCount; c++)
        {
            var cell = mesh.Cells[c];
            sb.Clear();
            float sumX = 0, sumY = 0;
            int cornerCount = cell.Intersections.Count;
            for (int idx = 0; idx < cornerCount; idx++)
            {
                if (idx > 0) sb.Append(' ');
                var inters = mesh.Intersections[cell.Intersections[idx]];
                float px = inters.X * S;
                float py = inters.Y * S;
                sumX += px;
                sumY += py;
                sb.AppendFormat(CultureInfo.InvariantCulture, "{0:F1},{1:F1}", px, py);
            }
            geom.CellPolygonPoints[c] = sb.ToString();

            float midX = cornerCount > 0 ? sumX / cornerCount : 0;
            float midY = cornerCount > 0 ? sumY / cornerCount : 0;
            geom.CellMidX[c] = midX;
            geom.CellMidY[c] = midY;
            geom.CellMidXStr[c] = midX.ToString("F1", CultureInfo.InvariantCulture);
            geom.CellMidYStr[c] = midY.ToString("F1", CultureInfo.InvariantCulture);

            float minEdgeDistSq = float.MaxValue;
            foreach (var edgeIdx in cell.Edges)
            {
                float dSq = DistanceToSegmentSq(midX, midY, geom.EdgeX1[edgeIdx], geom.EdgeY1[edgeIdx], geom.EdgeX2[edgeIdx], geom.EdgeY2[edgeIdx]);
                if (dSq < minEdgeDistSq) minEdgeDistSq = dSq;
            }
            float inradius = minEdgeDistSq < float.MaxValue ? MathF.Sqrt(minEdgeDistSq) : 16.0f;
            float fontSize = Math.Clamp(inradius * 0.95f, 13.0f, 22.0f);
            geom.CellFontSizeStr[c] = fontSize.ToString("F1", CultureInfo.InvariantCulture);
        }

        cachedGeometryMesh = mesh;
        cachedGeometry = geom;
        return geom;
    }

    private async Task SafeInvokeVoidAsync(string identifier, params object?[] args)
    {
        try
        {
            await JS.InvokeVoidAsync(identifier, args);
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or TaskCanceledException)
        {
            // Ignore transient/disposal JS interop errors
        }
    }

    private async Task<bool> TryLoadPuzzleFromHashAsync(string? rawHash)
    {
        if (!GameService.TryExtractPuzzleHashPayload(rawHash, out string normalizedHash, out string code))
            return false;

        // A) Try compact format directly without double-decoding
        if (code.Contains('/') && await TryLoadSavedOrTextAsync(code, normalizedHash))
        {
            return true;
        }

        // B) Fallback for legacy compressed URLs
        if (PuzzleCompression.TryDecompressFromUrlSafe(code, out string puzzleText) && !string.IsNullOrEmpty(puzzleText))
        {
            return await TryLoadSavedOrTextAsync(puzzleText, normalizedHash);
        }

        return false;
    }

    [JSInvokable]
    public async Task OnUrlHashChanged(string hash)
    {
        if (disposed || string.IsNullOrWhiteSpace(hash))
            return;

        if (Game.IsGenerating)
            Game.CancelGeneration();
        if (Game.IsBusy)
            return;

        try
        {
            string search = await JS.InvokeAsync<string>("loopHelpers.getUrlSearch");
            if (GameService.IsDebugQueryEnabled(search, hash))
            {
                await EnsureDebugInstallIdAsync();
                Game.SetDebugRecordingEnabled(true);
            }

            bool loaded = await TryLoadPuzzleFromHashAsync(hash);
            if (loaded)
            {
                showVictoryModal = false;
                showSolveModal = false;
                showResetModal = false;
                showFilesModal = false;
                showSettingsModal = false;
                showHelpModal = false;
                showDebugModal = false;
                isMenuOpen = false;
                lastSolvedState = Game.IsSolved;
                ResetZoom();
                ShowToast("Loaded shared puzzle!");
                StateHasChanged();
            }
            else if (hash.TrimStart('#').StartsWith("p=", StringComparison.OrdinalIgnoreCase) ||
                     hash.TrimStart('#').StartsWith("puzzle=", StringComparison.OrdinalIgnoreCase))
            {
                ShowToast("Could not load puzzle from link.");
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load puzzle from hash change: {ex.Message}");
        }
    }

    private async Task<bool> TryLoadSavedOrTextAsync(string puzzleText, string? alternateKey = null)
    {
        try
        {
            string? savedJson = await JS.InvokeAsync<string?>("loopHelpers.loadGameState");
            if (!string.IsNullOrEmpty(savedJson))
            {
                var savedState = JsonSerializer.Deserialize(savedJson, LoopJsonContext.Default.SavedGameState);
                if (savedState != null &&
                    (savedState.Puzzle == puzzleText || (alternateKey != null && savedState.Puzzle == alternateKey)) &&
                    Game.RestoreState(savedState))
                {
                    selectedType = Game.CurrentType.ToString();
                    return true;
                }
            }
        }
        catch (Exception ex) when (ex is JsonException or JSException)
        {
            Console.WriteLine($"Could not match saved game state: {ex.Message}");
        }

        if (Game.LoadPuzzleText(puzzleText, "hash"))
        {
            selectedType = Game.CurrentType.ToString();
            return true;
        }

        return false;
    }

    private void ShowToast(string message)
    {
        var prevCts = shareToastCts;
        shareToastCts = new CancellationTokenSource();
        if (prevCts != null)
        {
            prevCts.Cancel();
            prevCts.Dispose();
        }
        shareToastMessage = message;
        showShareToast = true;
        _ = HideShareToastLaterAsync(shareToastCts.Token);
    }

    private async Task HideShareToastLaterAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(2500, token);
            if (!token.IsCancellationRequested && !disposed)
            {
                showShareToast = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    protected override void OnInitialized()
    {
        selfRef = DotNetObjectReference.Create(this);
        Game.OnStateChanged += HandleStateChanged;
        Game.OnBoardPersistedStateChanged += HandleBoardPersistedStateChanged;
        // Timer ONLY updates UI while generating (for the 10s cancel hint). Gameplay clock is isolated in <GameTimer />.
        timer = new System.Threading.Timer(_ =>
        {
            if (!disposed && Game.IsGenerating)
            {
                _ = InvokeAsync(StateHasChanged);
            }
        }, null, 1000, 1000);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (selfRef != null)
            {
                await SafeInvokeVoidAsync("registerLoopShortcuts", selfRef);
            }

            try
            {
                string search = await JS.InvokeAsync<string>("loopHelpers.getUrlSearch");
                string initialHash = await JS.InvokeAsync<string>("loopHelpers.getUrlHash");
                bool debugEnabled = GameService.IsDebugQueryEnabled(search, initialHash);
                if (debugEnabled)
                {
                    await EnsureDebugInstallIdAsync();
                }
                Game.SetDebugRecordingEnabled(debugEnabled);
            }
            catch (JSException) { }

            try
            {
                string theme = await JS.InvokeAsync<string>("loopHelpers.getTheme");
                isDarkMode = (theme == "dark");
            }
            catch (JSException) { }

            try
            {
                if (await JS.InvokeAsync<bool>("loopHelpers.hasPendingPwaUpdate"))
                {
                    hasPwaUpdate = true;
                }
            }
            catch (JSException) { }

            try
            {
                string? prefsJson = await JS.InvokeAsync<string?>("loopHelpers.loadSettings");
                if (!string.IsNullOrEmpty(prefsJson))
                {
                    var savedPrefs = JsonSerializer.Deserialize(prefsJson, LoopJsonContext.Default.UserPreferences);
                    if (savedPrefs != null)
                    {
                        Game.ApplyPreferences(savedPrefs);
                    }
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Failed to load settings: {ex.Message}");
            }

            await SyncWheelModeAsync();

            bool loaded = false;
            // 1. Check URL hash for shared puzzle (#p=... or #puzzle=...)
            try
            {
                string hash = await JS.InvokeAsync<string>("loopHelpers.getUrlHash");
                if (!string.IsNullOrEmpty(hash))
                {
                    loaded = await TryLoadPuzzleFromHashAsync(hash);
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Failed to load puzzle from hash: {ex.Message}");
            }

            // 2. Check localStorage if no hash loaded
            if (!loaded)
            {
                try
                {
                    string? savedJson = await JS.InvokeAsync<string?>("loopHelpers.loadGameState");
                    if (!string.IsNullOrEmpty(savedJson))
                    {
                        var savedState = JsonSerializer.Deserialize(savedJson, LoopJsonContext.Default.SavedGameState);
                        if (savedState != null && Game.RestoreState(savedState))
                        {
                            loaded = true;
                            selectedType = Game.CurrentType.ToString();
                        }
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Failed to restore local state: {ex.Message}");
                }
            }

            // 3. Fallback to generating fresh puzzle
            if (!loaded)
            {
                await GeneratePuzzle();
            }
            else
            {
                ResetZoom();
                if (selfRef != null && Game.CurrentMesh != null)
                {
                    boardInitializedForMesh = Game.CurrentMesh;
                    await SafeInvokeVoidAsync("initLoopBoard", "game-board-svg", selfRef);
                }
                StateHasChanged();
            }
        }
        else if (Game.CurrentMesh != null && selfRef != null && !ReferenceEquals(boardInitializedForMesh, Game.CurrentMesh))
        {
            boardInitializedForMesh = Game.CurrentMesh;
            await SafeInvokeVoidAsync("initLoopBoard", "game-board-svg", selfRef);
        }

        if (Game.DebugRecordingEnabled && Game.DebugSessionId != lastResetDebugSessionId)
        {
            lastResetDebugSessionId = Game.DebugSessionId;
            debugSubmitted = false;
            debugSubmitMessage = null;
            debugSubmitIsError = false;
            await SafeInvokeVoidAsync("loopHelpers.resetSeenInputs");
        }
    }

    private bool lastSolvedState = false;

    private void HandleStateChanged()
    {
        if (disposed) return;

        if (!Game.IsVisualSolving && isVisualSolvePlaying)
        {
            StopVisualSolvePlayback();
        }

        if (Game.IsSolved && !lastSolvedState)
        {
            if (Game.DebugRecordingEnabled)
            {
                debugSubmitted = false;
                debugSubmitMessage = null;
                debugSubmitIsError = false;
                _ = CaptureSolveClientInfoAsync();
            }
            if (!Game.WasAutoSolved)
            {
                showVictoryModal = true;
            }
        }
        lastSolvedState = Game.IsSolved;

        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleBoardPersistedStateChanged()
    {
        if (disposed || Game.IsGenerating || Game.CurrentMesh == null) return;

        var prev = saveDebounceCts;
        saveDebounceCts = new CancellationTokenSource();
        if (prev != null)
        {
            prev.Cancel();
            prev.Dispose();
        }
        _ = SaveGameStateDebouncedAsync(saveDebounceCts.Token);
    }

    private async Task SaveGameStateDebouncedAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(150, token);
            if (token.IsCancellationRequested || disposed || Game.IsGenerating || Game.CurrentMesh == null)
                return;

            var state = Game.ExportState();
            if (state != null)
            {
                string json = JsonSerializer.Serialize(state, LoopJsonContext.Default.SavedGameState);
                bool ok = await JS.InvokeAsync<bool>("loopHelpers.saveGameState", json);
                if (!ok && !storageWarningShown)
                {
                    storageWarningShown = true;
                    ShowToast("Could not save progress to browser storage.");
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error auto-saving state: {ex.Message}");
        }
    }

