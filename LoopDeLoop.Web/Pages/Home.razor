    private string? BuildExportPayload(string kind, out string fileName, out string label)
    {
        fileName = "puzzle.loop";
        label = ".loop";
        switch (kind)
        {
            case "loop":
                return Game.ExportLoopText();
            case "ascii":
                fileName = "puzzle.txt";
                label = "ASCII grid";
                return Game.ExportSquareAscii();
            case "loopy":
                fileName = "puzzle.loopy";
                label = "Loopy save";
                return Game.ExportLoopySave();
            case "loopy-desc":
                fileName = "puzzle-loopy.txt";
                label = "Loopy code";
                return Game.ExportLoopyDescriptor();
            default:
                return null;
        }
    }

