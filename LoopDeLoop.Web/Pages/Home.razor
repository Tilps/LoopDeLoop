@page "/"
@inject GameService Game
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Loop-de-loop - Slitherlink Puzzle Game</PageTitle>

<div class="game-container">
    <!-- Header / Controls -->
    <header class="game-header">
        <div class="brand">
            <h1 class="brand-title">Loop-de-loop</h1>
            <span class="brand-badge">.NET 10</span>
        </div>

        <div class="controls-group">
            <div class="control-item">
                <label>Grid:</label>
                <select class="select-input" value="@selectedType" @onchange="OnTypeChanged" disabled="@Game.IsGenerating">
                    <option value="Square">Square</option>
                    <option value="Square Symmetrical">Square Symmetrical</option>
                    <option value="Triangle">Triangle</option>
                    <option value="Hexagon">Hexagon</option>
                    <option value="Hexagon2">Hexagon 2</option>
                    <option value="Hexagon3">Hexagon 3</option>
                    <option value="Octagon">Octagon</option>
                    <option value="Square2">Square 2</option>
                    <option value="Pentagon">Pentagon</option>
                </select>
            </div>

            <div class="control-item">
                <label>Size:</label>
                <input type="text" class="text-input" @bind="Game.SizeText" placeholder="10x10" disabled="@Game.IsGenerating" />
            </div>

            <div class="control-item">
                <label>Difficulty:</label>
                <select class="select-input" @bind="Game.Difficulty" disabled="@Game.IsGenerating">
                    <option value="0">Trivial</option>
                    <option value="1">Easy</option>
                    <option value="2">Easyish</option>
                    <option value="3">Moderate</option>
                    <option value="4">Maybe Harder</option>
                    <option value="5">Unlimited</option>
                </select>
            </div>

            <button class="btn btn-primary" @onclick="GeneratePuzzle" disabled="@Game.IsGenerating">
                @if (Game.IsGenerating)
                {
                    <span>Generating...</span>
                }
                else
                {
                    <span>New Puzzle</span>
                }
            </button>
        </div>

        <div class="controls-group">
            <label class="checkbox-label" title="Disallow moves that cause obvious rule violations (exceeding clue counts or vertex degree > 2)">
                <input type="checkbox" @bind="Game.DisallowFalseMove" />
                <span>Restrict invalid</span>
            </label>
            <label class="checkbox-label" title="Enable cell coloring for inside/outside marking (when off, clicking inside routes to nearest edge)">
                <input type="checkbox" @bind="Game.ShowCellColors" />
                <span>Cell shading</span>
            </label>
        </div>

        <div class="controls-group">
            <div class="timer-box" title="Elapsed Time">
                @(Game.ElapsedTime.ToString(@"mm\:ss"))
            </div>

            <button class="btn btn-secondary" @onclick="Game.Undo" disabled="@(!Game.CanUndo || Game.IsGenerating)" title="Undo (Ctrl+Z)">
                ↶ Undo
            </button>
            <button class="btn btn-secondary" @onclick="Game.Redo" disabled="@(!Game.CanRedo || Game.IsGenerating)" title="Redo (Ctrl+Y)">
                ↷ Redo
            </button>
            <button class="btn btn-secondary" @onclick="Game.Fix" disabled="@(Game.CurrentMesh == null || Game.IsGenerating)" title="Save Checkpoint (Ctrl+F)">
                Fix
            </button>
            <button class="btn btn-secondary" @onclick="Game.Unfix" disabled="@(Game.CurrentMesh == null || Game.IsGenerating)" title="Clear Checkpoint (Ctrl+U)">
                Unfix
            </button>
            <button class="btn btn-secondary" @onclick="Game.RevertToFix" disabled="@(Game.CurrentMesh == null || Game.IsGenerating)" title="Revert to Checkpoint (Ctrl+R)">
                Revert
            </button>
            <button class="btn btn-secondary" @onclick="() => showHelpModal = true" title="Instructions & Rules">
                Help
            </button>
        </div>
    </header>

    <!-- Main Game Board -->
    <main class="board-container">
        @if (Game.IsGenerating)
        {
            <div class="overlay-spinner">
                <div class="spinner"></div>
                <div class="spinner-text">Generating puzzle... (@Game.PrunedProgress clues checked)</div>
            </div>
        }

        @if (Game.CurrentMesh != null)
        {
            var mesh = Game.CurrentMesh;

            float minX = float.MaxValue, minY = float.MaxValue, maxX = float.MinValue, maxY = float.MinValue;
            foreach (var inters in mesh.Intersections)
            {
                float x = inters.X * S;
                float y = inters.Y * S;
                if (x < minX) minX = x;
                if (y < minY) minY = y;
                if (x > maxX) maxX = x;
                if (y > maxY) maxY = y;
            }

            float pad = 30.0f;
            float vbX = minX - pad;
            float vbY = minY - pad;
            float vbW = (maxX - minX) + pad * 2;
            float vbH = (maxY - minY) + pad * 2;
            if (vbW < 10) vbW = 100;
            if (vbH < 10) vbH = 100;

            float vertexRadius = 3.5f;

            <svg id="game-board-svg" class="svg-board" viewBox="@($"{vbX:F1} {vbY:F1} {vbW:F1} {vbH:F1}")" preserveAspectRatio="xMidYMid meet">
                <!-- Layer 1: Cell backgrounds (for interior/exterior shading) -->
                <g class="cells-layer" style="pointer-events: none;">
                    @for (int c = 0; c < mesh.Cells.Count; c++)
                    {
                        var cell = mesh.Cells[c];
                        var pointsStr = string.Join(" ", cell.Intersections.Select(i => $"{(mesh.Intersections[i].X * S):F1},{(mesh.Intersections[i].Y * S):F1}"));

                        string cellFill = "transparent";
                        if (cell.Color == 1) cellFill = "#fef3c7"; // Warm yellow (inside)
                        else if (cell.Color == -1) cellFill = "#e2e8f0"; // Cool gray (outside)

                        <polygon points="@pointsStr"
                                 fill="@cellFill"
                                 class="cell-poly"
                                 style="pointer-events: none;" />
                    }
                </g>

                <!-- Layer 2: Empty Grid Edges (faint background guidelines) -->
                <g class="empty-edges-layer" style="pointer-events: none;">
                    @for (int e = 0; e < mesh.Edges.Count; e++)
                    {
                        var edge = mesh.Edges[e];
                        if (edge.State == EdgeState.Empty)
                        {
                            mesh.GetEdgeExtent(edge, out float rawX1, out float rawY1, out float rawX2, out float rawY2);
                            float x1 = rawX1 * S, y1 = rawY1 * S, x2 = rawX2 * S, y2 = rawY2 * S;
                            <line x1="@x1" y1="@y1" x2="@x2" y2="@y2"
                                  class="edge-empty"
                                  style="pointer-events: none;" />
                        }
                    }
                </g>

                <!-- Layer 3: Cell Clue Numbers (rendered as pure SVG text, always on top of background lines) -->
                <g class="cell-clues-layer" style="pointer-events: none;">
                    @for (int c = 0; c < mesh.Cells.Count; c++)
                    {
                        var cell = mesh.Cells[c];
                        if (cell.TargetCount >= 0)
                        {
                            float sumX = 0, sumY = 0;
                            foreach (var i in cell.Intersections)
                            {
                                sumX += mesh.Intersections[i].X * S;
                                sumY += mesh.Intersections[i].Y * S;
                            }
                            float midX = sumX / cell.Intersections.Count;
                            float midY = sumY / cell.Intersections.Count;

                            float minEdgeDistSq = float.MaxValue;
                            foreach (var edgeIdx in cell.Edges)
                            {
                                mesh.GetEdgeExtent(mesh.Edges[edgeIdx], out float rawX1, out float rawY1, out float rawX2, out float rawY2);
                                float dSq = DistanceToSegmentSq(midX, midY, rawX1 * S, rawY1 * S, rawX2 * S, rawY2 * S);
                                if (dSq < minEdgeDistSq) minEdgeDistSq = dSq;
                            }
                            float inradius = MathF.Sqrt(minEdgeDistSq);
                            float fontSize = Math.Clamp(inradius * 0.95f, 13.0f, 22.0f);

                            string numColor = "#1e293b";
                            if (cell.FilledCount == cell.TargetCount) numColor = "#64748b";
                            else if (cell.FilledCount > cell.TargetCount) numColor = "#ef4444";

                            @RenderCellClue(midX, midY, cell.TargetCount, numColor, fontSize)
                        }
                    }
                </g>

                <!-- Layer 4: Active Edges (Filled loops & Excluded cross marks) -->
                <g class="active-edges-layer" style="pointer-events: none;">
                    @for (int e = 0; e < mesh.Edges.Count; e++)
                    {
                        int edgeIdx = e;
                        var edge = mesh.Edges[edgeIdx];
                        if (edge.State != EdgeState.Empty)
                        {
                            mesh.GetEdgeExtent(edge, out float rawX1, out float rawY1, out float rawX2, out float rawY2);
                            float x1 = rawX1 * S, y1 = rawY1 * S, x2 = rawX2 * S, y2 = rawY2 * S;
                            bool isMarked = Game.MarkedEdges.Contains(edgeIdx);

                            if (edge.State == EdgeState.Filled)
                            {
                                <line x1="@x1" y1="@y1" x2="@x2" y2="@y2"
                                      class="@(isMarked ? "edge-filled-marked" : "edge-filled")"
                                      style="pointer-events: none;" />
                            }
                            else if (edge.State == EdgeState.Excluded)
                            {
                                float mx = (x1 + x2) / 2.0f;
                                float my = (y1 + y2) / 2.0f;
                                float edx = x2 - x1;
                                float edy = y2 - y1;
                                float elen = MathF.Sqrt(edx * edx + edy * edy);
                                if (elen < 1e-4f) elen = 1.0f;
                                float ux = edx / elen;
                                float uy = edy / elen;
                                float vx = -uy;
                                float vy = ux;

                                float r = 3.6f;
                                float o1x = r * (ux + vx);
                                float o1y = r * (uy + vy);
                                float o2x = r * (ux - vx);
                                float o2y = r * (uy - vy);

                                string crossClass = isMarked ? "edge-cross-marked" : "edge-cross";
                                <line x1="@(mx - o1x)" y1="@(my - o1y)" x2="@(mx + o1x)" y2="@(my + o1y)"
                                      class="@crossClass"
                                      style="pointer-events: none;" />
                                <line x1="@(mx - o2x)" y1="@(my - o2y)" x2="@(mx + o2x)" y2="@(my + o2y)"
                                      class="@crossClass"
                                      style="pointer-events: none;" />
                            }
                        }
                    }
                </g>

                <!-- Layer 5: Intersection Vertices (clean corner dots) -->
                <g class="vertices-layer" style="pointer-events: none;">
                    @foreach (var inters in mesh.Intersections)
                    {
                        <circle cx="@(inters.X * S)" cy="@(inters.Y * S)" r="@vertexRadius" class="vertex-dot" style="pointer-events: none;" />
                    }
                </g>
            </svg>
        }
    </main>

    <!-- Footer Shortcuts Info -->
    <footer class="game-footer">
        <div>
            Shortcuts:
            <span class="shortcut-badge">Ctrl+Z</span> Undo &bull;
            <span class="shortcut-badge">Ctrl+Y</span> Redo &bull;
            <span class="shortcut-badge">Ctrl+F</span> Fix &bull;
            <span class="shortcut-badge">Ctrl+U</span> Unfix &bull;
            <span class="shortcut-badge">Ctrl+R</span> Revert
        </div>
        <div>
            Left-Click / Drag: Draw line &bull; Right-Click / Drag: Mark X &bull; Shift: Reverse cycle &bull; Fixed edges locked
        </div>
    </footer>
</div>

<!-- Victory Modal -->
@if (Game.IsSolved && showVictoryModal)
{
    <div class="modal-backdrop">
        <div class="modal-card">
            <div class="victory-badge">🏆</div>
            <h2 class="modal-title">Puzzle Solved!</h2>
            <div class="modal-body" style="text-align: center;">
                <p>Congratulations! You successfully solved the loop in <strong>@(Game.ElapsedTime.ToString(@"mm\:ss"))</strong>!</p>
            </div>
            <div class="modal-actions" style="justify-content: center;">
                <button class="btn btn-secondary" @onclick="() => showVictoryModal = false">Review Board</button>
                <button class="btn btn-success" @onclick="GeneratePuzzle">New Puzzle</button>
            </div>
        </div>
    </div>
}

<!-- Help / Rules Modal -->
@if (showHelpModal)
{
    <div class="modal-backdrop" @onclick="() => showHelpModal = false">
        <div class="modal-card" @onclick:stopPropagation="true">
            <h2 class="modal-title">How to Play Loop-de-loop</h2>
            <div class="modal-body">
                <p><strong>Goal:</strong> Form a single continuous non-crossing loop by connecting adjacent grid points.</p>
                <ul>
                    <li>Numbers inside cells indicate how many of that cell's edges are part of the loop.</li>
                    <li>Cells without numbers may have any number of edges.</li>
                    <li>The loop cannot branch or cross itself — every grid vertex along the loop must connect exactly 2 edges.</li>
                </ul>
                <p><strong>Controls:</strong></p>
                <ul>
                    <li><strong>Left-Click or Drag</strong> on an edge: draw / cycle Empty ➔ Filled ➔ Excluded ➔ Empty.</li>
                    <li><strong>Right-Click or Drag</strong>: mark Excluded crosses (X).</li>
                    <li><strong>Shift + Click</strong>: reverses the cycling direction of left and right clicks.</li>
                    <li><strong>Clicking inside cells</strong>: automatically routes to the closest edge of the cell!</li>
                    <li><strong>Cell shading option</strong>: when enabled, clicking near the center of a cell shades it (Yellow = inside, Gray = outside).</li>
                    <li><strong>Restrict invalid option</strong>: when enabled, moves causing obvious contradictions (e.g. vertex degree > 2 or clue count exceeded) are blocked. When off (default), moves cycle freely regardless of rules.</li>
                    <li><strong>Fix (Ctrl+F)</strong>: Save a checkpoint (current moves turn green and become locked against changes).</li>
                    <li><strong>Unfix (Ctrl+U)</strong>: Clear checkpoint and unlock fixed edges.</li>
                    <li><strong>Revert (Ctrl+R)</strong>: Rollback all moves made after your last checkpoint.</li>
                </ul>
            </div>
            <div class="modal-actions">
                <button class="btn btn-primary" @onclick="() => showHelpModal = false">Got it!</button>
            </div>
        </div>
    </div>
}

@code {
    private const float S = 50.0f; // Scale factor: 50 pixels per grid unit

    private string selectedType = "Square";
    private bool showVictoryModal = true;
    private bool showHelpModal = false;

    private bool isPointerDown = false;
    private EdgeState? dragTargetState = null;
    private int lastClosestEdge = -1;
    private int lastClosestCell = -1;
    private IDisposable? timer;
    private DotNetObjectReference<Home>? selfRef;

    private RenderFragment RenderCellClue(float x, float y, int clue, string color, float fontSize) => builder =>
    {
        builder.OpenElement(0, "text");
        builder.AddAttribute(1, "x", x.ToString("F1", System.Globalization.CultureInfo.InvariantCulture));
        builder.AddAttribute(2, "y", y.ToString("F1", System.Globalization.CultureInfo.InvariantCulture));
        builder.AddAttribute(3, "font-size", fontSize.ToString("F1", System.Globalization.CultureInfo.InvariantCulture));
        builder.AddAttribute(4, "font-weight", "800");
        builder.AddAttribute(5, "font-family", "system-ui, -apple-system, sans-serif");
        builder.AddAttribute(6, "text-anchor", "middle");
        builder.AddAttribute(7, "dominant-baseline", "central");
        builder.AddAttribute(8, "fill", color);
        builder.AddAttribute(9, "class", "cell-svg-text");
        builder.AddAttribute(10, "style", "pointer-events: none; user-select: none;");
        builder.AddContent(11, clue.ToString());
        builder.CloseElement();
    };

    protected override void OnInitialized()
    {
        selfRef = DotNetObjectReference.Create(this);
        Game.OnStateChanged += HandleStateChanged;
        timer = new System.Threading.Timer(_ =>
        {
            if (Game.StartTime.HasValue && !Game.IsSolved && !Game.IsGenerating)
            {
                InvokeAsync(StateHasChanged);
            }
        }, null, 1000, 1000);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (selfRef != null)
            {
                await JS.InvokeVoidAsync("registerLoopShortcuts", selfRef);
            }
            await GeneratePuzzle();
        }
        else if (Game.CurrentMesh != null && selfRef != null)
        {
            await JS.InvokeVoidAsync("initLoopBoard", "game-board-svg", selfRef);
        }
    }

    private bool lastSolvedState = false;

    private void HandleStateChanged()
    {
        if (Game.IsSolved && !lastSolvedState)
        {
            showVictoryModal = true;
        }
        lastSolvedState = Game.IsSolved;
        InvokeAsync(StateHasChanged);
    }

    private async Task GeneratePuzzle()
    {
        showVictoryModal = false;
        lastSolvedState = false;
        await Game.GenerateNewPuzzleAsync();
        if (selfRef != null)
        {
            await JS.InvokeVoidAsync("initLoopBoard", "game-board-svg", selfRef);
        }
    }

    private void OnTypeChanged(ChangeEventArgs e)
    {
        selectedType = e.Value?.ToString() ?? "Square";
        Game.CurrentType = PuzzleHelper.MeshTypeFromString(selectedType);
        PuzzleHelper.GetDefaultSize(Game.CurrentType, out int w, out int h);
        Game.SizeText = $"{w}x{h}";
    }

    private static float DistanceToSegmentSq(float px, float py, float sx, float sy, float ex, float ey)
    {
        float dx = ex - sx;
        float dy = ey - sy;
        float lenSq = dx * dx + dy * dy;
        if (lenSq == 0)
        {
            float ddx = px - sx;
            float ddy = py - sy;
            return ddx * ddx + ddy * ddy;
        }
        float t = Math.Clamp(((px - sx) * dx + (py - sy) * dy) / lenSq, 0.0f, 1.0f);
        float nearX = sx + t * dx;
        float nearY = sy + t * dy;
        float distx = nearX - px;
        float disty = nearY - py;
        return distx * distx + disty * disty;
    }

    private void FindClosest(float px, float py, out int closestEdge, out int closestCell, float minSep = 0.0f)
    {
        closestEdge = -1;
        closestCell = -1;
        if (Game.CurrentMesh == null) return;

        var mesh = Game.CurrentMesh;
        float distanceSq = float.MaxValue;
        float secondDistanceSq = float.MaxValue;

        for (int i = 0; i < mesh.Edges.Count; i++)
        {
            mesh.GetEdgeExtent(mesh.Edges[i], out float rawX1, out float rawY1, out float rawX2, out float rawY2);
            float curDistSq = DistanceToSegmentSq(px, py, rawX1 * S, rawY1 * S, rawX2 * S, rawY2 * S);
            if (curDistSq <= distanceSq)
            {
                secondDistanceSq = distanceSq;
                distanceSq = curDistSq;
                closestEdge = i;
            }
            else if (curDistSq <= secondDistanceSq)
            {
                secondDistanceSq = curDistSq;
            }
        }

        if (Game.ShowCellColors)
        {
            for (int c = 0; c < mesh.Cells.Count; c++)
            {
                var cell = mesh.Cells[c];
                float sumX = 0, sumY = 0;
                foreach (int inters in cell.Intersections)
                {
                    sumX += mesh.Intersections[inters].X * S;
                    sumY += mesh.Intersections[inters].Y * S;
                }
                float cx = sumX / cell.Intersections.Count;
                float cy = sumY / cell.Intersections.Count;
                float distx = cx - px;
                float disty = cy - py;
                float curDistSq = distx * distx + disty * disty;
                if (curDistSq <= distanceSq)
                {
                    closestEdge = -1;
                    closestCell = c;
                    secondDistanceSq = distanceSq;
                    distanceSq = curDistSq;
                }
                else if (curDistSq <= secondDistanceSq)
                {
                    secondDistanceSq = curDistSq;
                }
            }
        }

        // Ignore clicks too far away (> 1.2 grid units from any element)
        float maxAllowedSq = (1.2f * S) * (1.2f * S);
        if (distanceSq > maxAllowedSq)
        {
            closestEdge = -1;
            closestCell = -1;
            return;
        }

        if (minSep > 0 && distanceSq + 2 * minSep * MathF.Sqrt(distanceSq) + minSep * minSep > secondDistanceSq)
        {
            closestEdge = -1;
            closestCell = -1;
        }
    }

    [JSInvokable]
    public void OnSvgPointerDown(double x, double y, int button, bool shiftKey)
    {
        if (Game.CurrentMesh == null || Game.IsGenerating) return;

        float fx = (float)x;
        float fy = (float)y;
        FindClosest(fx, fy, out int closestEdge, out int closestCell, 0.0f);

        lastClosestEdge = closestEdge;
        lastClosestCell = closestCell;

        bool isRight = button == 2; // Right click
        bool isAlt = shiftKey ? !isRight : isRight; // Shift reverses cycle direction

        if (closestEdge != -1)
        {
            if (Game.MarkedEdges.Contains(closestEdge))
                return; // Fixed edges cannot be clicked or changed

            isPointerDown = true;
            Game.ToggleEdge(closestEdge, isAlt);
            dragTargetState = Game.CurrentMesh.Edges[closestEdge].State;
        }
        else if (closestCell != -1 && Game.ShowCellColors)
        {
            isPointerDown = true;
            Game.ToggleCellColor(closestCell, isAlt);
        }
    }

    [JSInvokable]
    public void OnSvgPointerMove(double x, double y)
    {
        if (!isPointerDown || Game.CurrentMesh == null || Game.IsGenerating) return;
        if (!dragTargetState.HasValue) return;

        float fx = (float)x;
        float fy = (float)y;
        float minSep = 8.0f; // 8px buffer to avoid edge flutter during drag
        FindClosest(fx, fy, out int closestEdge, out int closestCell, minSep);

        if (closestEdge != -1 && closestEdge != lastClosestEdge)
        {
            lastClosestEdge = closestEdge;
            if (!Game.MarkedEdges.Contains(closestEdge))
            {
                Game.SetEdgeDirect(closestEdge, dragTargetState.Value);
            }
        }
    }

    [JSInvokable]
    public void OnSvgPointerUp()
    {
        isPointerDown = false;
        dragTargetState = null;
        lastClosestEdge = -1;
        lastClosestCell = -1;
    }

    [JSInvokable]
    public void OnShortcut(string action)
    {
        switch (action)
        {
            case "undo": Game.Undo(); break;
            case "redo": Game.Redo(); break;
            case "fix": Game.Fix(); break;
            case "unfix": Game.Unfix(); break;
            case "revert": Game.RevertToFix(); break;
        }
    }

    public void Dispose()
    {
        Game.OnStateChanged -= HandleStateChanged;
        timer?.Dispose();
        selfRef?.Dispose();
    }
}

